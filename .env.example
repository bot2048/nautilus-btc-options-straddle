# Copy to `.env` and fill in the pair for the environment you run against.
# Never commit `.env`.

# Bybit testnet (https://testnet.bybit.com -> API Management). Used by default.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Bybit demo trading (bybit.com -> switch to Demo Trading -> API). Used with `--env demo`.
BYBIT_DEMO_API_KEY=
BYBIT_DEMO_API_SECRET=
